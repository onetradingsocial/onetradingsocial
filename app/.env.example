NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=OneTradingSocial
# Private-by-intent uploads (trade charts, DM attachments). public = false with
# owner-only storage RLS; read only through /api/private-image. Server-only on
# purpose — the browser learns the name from the upload route, never the bundle.
SUPABASE_PRIVATE_BUCKET=OneTradingSocial-private
# The app's own origin (used for OAuth redirect callbacks)
NEXT_PUBLIC_SITE_URL=
# The public marketing site origin (used to link the signup consent to /terms and /disclaimer)
NEXT_PUBLIC_MARKETING_URL=https://www.tradingsocial.io
# Stripe billing integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TRADER_MONTHLY=price_...
STRIPE_PRICE_TRADER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
# Optional beta promo coupon applied to annual checkouts (76% off list = 80% off monthly rate).
# Remove/leave empty to end the promo.
STRIPE_COUPON_BETA_ANNUAL=

# MT5 auto-sync (phase 2)
# MetaApi.cloud API token (https://app.metaapi.cloud → API tokens). Feature ships dark without it.
METAAPI_TOKEN=
# Random secret; Vercel sends it as "Authorization: Bearer <value>" on cron invocations.
CRON_SECRET=

# Reddit Conversions API — non-expiring token from Events Manager -> Conversions API.
# Server-only (no NEXT_PUBLIC). Feature no-ops when empty.
# Only fires for visitors who turned Advertising ON in the consent notice.
REDDIT_CONVERSIONS_TOKEN=

# Reddit CAPI: include the visitor's IP address in the conversion payload.
# OFF unless set to exactly "1", and even then the IP is SHA-256 hashed, never
# raw (audit item 17 F3 — it used to be sent raw, which is a directly
# identifying value going server-to-server to an overseas recipient with no
# browser control able to stop it). Turn on ONLY if Reddit match rates prove to
# need it; the hashed email, hashed account id and conversion_id already carry
# the attribution and the dedup. If you turn it on, update section 10 of
# privacy.html, which currently states we do not send it.
REDDIT_CAPI_SEND_IP=

# Meta (Facebook) pixel — standard events on the auth/billing funnel.
# Defaults to the production pixel id when unset.
NEXT_PUBLIC_META_PIXEL_ID=

# Reddit pixel — same funnel, same advertising consent tier (audit item 10
# finding 5). Pixel ids are public by nature (they appear in page source), so
# this is config, not a credential. It falls back to the PRODUCTION pixel id
# when unset, which means a fork of this public repo fires analytics into
# TradingSocial's ad account by default — set it explicitly on any non-prod
# deploy, or set it to a value that is not a real pixel.
NEXT_PUBLIC_REDDIT_PIXEL_ID=

# Twelve Data market data (symbol search + live quotes in trade journal).
# Free tier: https://twelvedata.com — 800 credits/day, shared by the WHOLE
# platform. Unset = static search only, no price chip.
# Spend is bounded in code by lib/server/market-quota.ts: 600 of the 800 daily
# credits, plus 30/minute per user. Raise both together if the plan changes.
TWELVEDATA_API_KEY=

# End-of-trial paywall. The 14-day Pro trial always runs; this only controls
# whether the blocking end-of-trial modal renders. Ship with 'false', flip to
# 'true' once the first cohort is genuinely 14 days past signup.
TRIAL_WALL_ENABLED=false

# Supabase "Confirm email" mirror (item 9 F2). MUST be flipped to 'on' in the
# same change as the dashboard toggle, never before it and never after it.
# A signUp that returns no session is ambiguous — "confirm your inbox" when
# confirmation is ON, "that address is already registered" when it is OFF — and
# the two need opposite copy. Off by default, so the code deploys inert.
AUTH_EMAIL_CONFIRMATION=off

# Salt for the pseudonym stamped onto moderation reports at account deletion
# (item 6 F6.8). trade_reports.reported_user_hash keeps the report usable after
# the reported account is erased, without retaining an identifier — it is a
# SHA-256 of "<salt>:<lowercased email>". The salt is what stops the column
# being a lookup table of every address ever reported, so use a long random
# value and NEVER rotate it: rotating orphans every hash already stored.
# Unset is safe — deletion logs and skips the stamp, and the report row still
# survives. The retention, not the pseudonym, is the part that matters.
DELETION_HASH_SALT=

# Admin allowlist. Comma-separated EXACT addresses — `local@domain`, nothing
# else (item 18 F1). A bare `@domain` entry used to be a domain-suffix wildcard
# and is now dropped at parse time, so pasting an old value yields NO admins
# from that entry rather than a whole namespace of them. Fail closed.
# Admin is granted purely by an address matching auth.users.email, so every
# entry here must be an address the business actually controls: with email
# confirmation off, "controls the mailbox" is never proven at signup.
ADMIN_EMAILS=

# E2E ONLY, and DEV ONLY. The seeded admin the Playwright admin specs log in as
# — they can no longer mint an admin by signing up, which is the point. Must
# match an exact entry in ADMIN_EMAILS on the dev server. Unset simply skips
# the admin specs. NEVER set these against the production project.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Added by WS8 (audit item 10 finding 5, item 19 finding F6). Every one of
# these is read by running code and none of them was documented here, which is
# how a fresh deploy ends up with no admins and no lifecycle email and nobody
# noticing for a fortnight. Two fail hard, four fail SILENTLY — the silent ones
# are the dangerous half.
# ---------------------------------------------------------------------------

# AES-256-GCM master key protecting every user's exchange (Binance) API key and
# secret. Generate with: openssl rand -base64 32  (must decode to 32 bytes.)
#
# READ BEFORE ROTATING. lib/server/secrets.ts reads exactly ONE key, so rotating
# this value makes every existing api_key_enc / api_secret_enc row permanently
# undecryptable — crypto sync dies for every Pro user with no recovery short of
# asking each of them to re-enter their Binance credentials. The 'v1' envelope
# prefix anticipates key versioning but the code does not yet use it for key
# selection. Making this rotatable (a decrypt-only EXCHANGE_KEY_SECRET_PREVIOUS
# alongside it) is open work — see docs/secret-rotation.md.
#
# Unset does not fail at boot: it throws at the moment a user first connects an
# exchange, i.e. in production, in front of a paying customer.
EXCHANGE_KEY_SECRET=

# Resend API key for outbound email (weekly digest, inactivity nudge, trial and
# payment notices, deletion confirmation). Unset is SILENT: sendEmail() returns
# { sent: false } and callers fall back to an in-app notification only. Nobody
# gets an error; the mail simply stops.
RESEND_API_KEY=

# From address on that mail. Falls back to a hard-coded sender when unset, so a
# misconfigured deploy sends from an address the domain may not authorise.
EMAIL_FROM=

# Incoming webhook (Discord/Slack) that api/cron/error-alert posts daily
# summaries to. A webhook URL IS a credential — anyone holding it can post into
# the team channel — so treat it as one and keep it out of screenshots.
# Unset is SILENT: alerts are computed and then dropped.
# The content is count-only ("3 client errors in the last 24h") and carries no
# user data; audit item 19 verified that and it must stay true.
ALERT_WEBHOOK_URL=

# Kill switch for the welcome/tier popup. Opt-OUT: the popup is live, and it is
# suppressed only when this is exactly 'true'. Nothing is lost while disabled —
# welcome_tier_seen simply stops being written — so users become eligible again
# when it is turned back on.
WELCOME_POPUP_DISABLED=
