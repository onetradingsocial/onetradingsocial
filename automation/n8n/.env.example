# TradingSocial marketing automation — n8n environment
#
# Copy to `.env` in this same folder and fill in. `.env` is gitignored.
#
# The Telegram bot token is NOT here — it lives in n8n's encrypted credential
# store, so it never touches a plaintext file or the workflow JSON.

# ---------------------------------------------------------------------------
# n8n itself
# ---------------------------------------------------------------------------
N8N_PORT=5678

# n8n listens on 0.0.0.0 regardless of this. N8N_HOST only controls the hostname
# n8n writes into generated URLs. Remote access is gated by your firewall.
# For local-only use leave it as localhost. To reach it over Tailscale, set it
# to this machine's MagicDNS name (`tailscale status --json` -> Self.DNSName)
# and uncomment the three lines below.
N8N_HOST=localhost
# N8N_PROTOCOL=http
# WEBHOOK_URL=http://<machine>.<tailnet>.ts.net:5678/
# N8N_EDITOR_BASE_URL=http://<machine>.<tailnet>.ts.net:5678/

# Required to log in over plain http from anything other than localhost.
# Safe inside Tailscale (WireGuard encrypts the transport). NOT safe over LAN.
N8N_SECURE_COOKIE=false

# Lets Code nodes read/write the content queue on disk. Required — without it
# every workflow fails at the first Code node with "Cannot find module 'fs'".
NODE_FUNCTION_ALLOW_BUILTIN=fs,path

# n8n 2.x blocks $env inside Code nodes by default. The workflows read their
# config (queue path, IG_USER_ID, TikTok keys) from the environment, so this must
# be false or every workflow fails with "access to env vars denied".
#
# Trade-off: any Code node can then read ALL env vars, including tokens. Fine for
# a single-operator instance; if you ever give someone else workflow-edit access,
# remember that is equivalent to handing them the credentials.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# All cron schedules are interpreted in this timezone. Set it to the timezone
# your audience is in, not the server's. IANA format.
GENERIC_TIMEZONE=UTC
TZ=UTC

# Pin this so credentials survive a reinstall and can be restored from backup.
# Generate once with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
# If you change it later, every saved credential becomes unreadable.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Content queue — the single source of every post
# ---------------------------------------------------------------------------
TS_CONTENT_QUEUE=C:\work\OneTradingSocial\Website\automation\n8n\content-queue.json

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Where posts go. Public channel: @channelusername. Private: numeric id
# (usually negative, e.g. -1001234567890).
TELEGRAM_CHAT_ID=

# Where operational alerts go — currently the Instagram token-refresh warning.
# Make this your own DM with the bot so alerts don't hit the public channel.
# Falls back to TELEGRAM_CHAT_ID if unset.
TELEGRAM_REVIEW_CHAT_ID=

# ---------------------------------------------------------------------------
# TikTok  (see README step 6)
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Obtained once via the OAuth consent flow. Rotates on every refresh; after the
# first run n8n keeps the current one in workflow static data, so this is only
# the seed.
TIKTOK_REFRESH_TOKEN=

# inbox  = upload as a draft to the TikTok inbox for Nathan to finish and post.
#          Works with an UNAUDITED app. The realistic starting point.
# direct = publish straight to the account. Requires the video.publish scope
#          AND an approved TikTok app audit, otherwise TikTok silently forces
#          the post to SELF_ONLY (nobody sees it).
TIKTOK_MODE=inbox

# Only used when TIKTOK_MODE=direct. Must be one of the values TikTok returns in
# privacy_level_options; the workflow falls back to the first allowed option.
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ---------------------------------------------------------------------------
# Instagram  (see README step 8)
# ---------------------------------------------------------------------------
# Numeric Instagram professional-account ID (Business or Creator, linked to a
# Facebook Page). Personal accounts have no publishing API.
IG_USER_ID=

# Long-lived token from the OAuth consent. Only a SEED — after the token-refresh
# workflow runs once, instagram-token.json on disk becomes the source of truth.
# Tokens die after 60 days and cannot be refreshed once expired, so leave that
# workflow active.
IG_ACCESS_TOKEN=

# Instagram Login path. For the Facebook Login path use
# https://graph.facebook.com/v23.0 and swap the token for a Page token.
IG_GRAPH_BASE=https://graph.instagram.com/v23.0
